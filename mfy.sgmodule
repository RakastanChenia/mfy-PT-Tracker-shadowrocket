mfy-upload-tutorial = type=http-response,pattern=^https://mkcn-prod-public-60001-(1|2)\.dailygn\.com/api/user/\d+/mysekai/tutorial/harvest$,requires-body=1,binary-body-mode=1,max-size=100000000,timeout=120,script-path=https://sub.167.234.217.255.sslip.io/mfy/mfy-upload-v3.js?v=557e5b5f
