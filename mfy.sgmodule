mfy-upload-live = type=http-response,pattern=^https://mkcn-prod-public-60001-(1|2)\.dailygn\.com/api/user/\d+/live/[^?]+(\?.*)?$,requires-body=1,binary-body-mode=1,max-size=100000000,timeout=120,script-path=https://sub.167.234.217.255.sslip.io/mfy/mfy-upload-v4.js?v=8db9e559
mfy-upload-multi = type=http-response,pattern=^https://mkcn-prod-public-60001-(1|2)\.dailygn\.com/api/user/\d+/multi-live/[^?]+(\?.*)?$,requires-body=1,binary-body-mode=1,max-size=100000000,timeout=120,script-path=https://sub.167.234.217.255.sslip.io/mfy/mfy-upload-v4.js?v=8db9e559
mfy-upload-challenge = type=http-response,pattern=^https://mkcn-prod-public-60001-(1|2)\.dailygn\.com/api/user/\d+/challenge-live/solo/[^?]+(\?.*)?$,requires-body=1,binary-body-mode=1,max-size=100000000,timeout=120,script-path=https://sub.167.234.217.255.sslip.io/mfy/mfy-upload-v4.js?v=8db9e559
mfy-upload-rank = type=http-response,pattern=^https://mkcn-prod-public-60001-(1|2)\.dailygn\.com/api/user/\d+/rank-match-season/\d+/live/[^?]+\?.*type=result.*$,requires-body=1,binary-body-mode=1,max-size=100000000,timeout=120,script-path=https://sub.167.234.217.255.sslip.io/mfy/mfy-upload-v4.js?v=8db9e559
